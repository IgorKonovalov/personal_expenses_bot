{
  "name": "personal-expenses-bot",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true,filter:(p)=>!p.includes('.')||p.endsWith('.sql')})\"",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json}": "prettier --check"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "better-sqlite3": "13.0.3",
    "date-fns": "4.4.0",
    "grammy": "1.46.0",
    "pino": "10.3.1",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
