# Telegram bot token from @BotFather.
BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user ids allowed to use the bot. Everyone else is ignored.
ALLOWED_TELEGRAM_IDS=111111111,222222222
# IANA timezone given to newly provisioned users.
DEFAULT_TIMEZONE=Europe/Belgrade
# ISO-4217 code used as a new personal ledger's default currency.
DEFAULT_CURRENCY=RSD
# SQLite file. The directory is created on boot.
DATABASE_PATH=./data/bot.sqlite
# pino level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
