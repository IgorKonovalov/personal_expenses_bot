# Telegram bot token from @BotFather.
BOT_TOKEN=123456:replace-me
# The admin's Telegram user id: always admitted, makes invite links with /invite, and receives
# version announcements. Replaces the retired ALLOWED_TELEGRAM_IDS, which now fails the boot.
ADMIN_TELEGRAM_ID=111111111
# Optional, comma-separated Telegram user ids admitted at boot if not already. Everyone else
# joins by an invite link. Removing an id later revokes nothing; /block does.
ADMIT_TELEGRAM_IDS=222222222
# IANA timezone given to newly provisioned users; each user changes their own in /settings. Also
# the fallback when a stored timezone is not one the runtime knows.
DEFAULT_TIMEZONE=Europe/Belgrade
# ISO-4217 code used as a new personal ledger's default currency; the ledger's owner changes it
# in /settings.
DEFAULT_CURRENCY=RSD
# SQLite file. The directory is created on boot. Docker Compose overrides it with
# /app/data/bot.sqlite on the bot-data volume.
DATABASE_PATH=./data/bot.sqlite
# Directory for daily SQLite backups, one expenses-YYYY-MM-DD.sqlite per UTC day, written at boot
# and every 24 h. Unset means no backups (local dev). Docker Compose sets it.
# BACKUP_DIR=
# How many daily backup files to keep. Older ones are deleted.
BACKUP_KEEP=14
# Docker Compose only: the host directory bind-mounted as the container's backup directory. It
# must exist and be writable by uid 1000. On the VPS: /home/botuser/backups/personal-expenses-bot
# HOST_BACKUP_DIR=/var/backups/personal-expenses-bot
# pino level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Optional external donation page (e.g. Ko-fi), shown as a button under /donate next to the
# Telegram Stars buttons. Must be an https: URL. Unset hides the button.
# DONATE_URL=https://ko-fi.com/example
# Optional: where GitHub Pages serves the Mini App page (webapp/). Set, the private-chat menu
# gains «📷 Скан», a live receipt QR scanner. Must be an https: URL without a #fragment. Unset
# hides the button.
# WEBAPP_URL=https://example.github.io/personal-expenses-bot/
