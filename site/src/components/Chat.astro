---
// Draws one generated chat (ADR-0048): `pnpm docs:chats` ran the scenario named `name` through
// the real bot and wrote its transcript. User bubbles sit right, the bot's left, with its inline
// keyboard under the bubble, a sent file as a file bubble, a callback toast as a centred line,
// and the chat's last bottom keyboard under it all. A chart button opens the real Mini App below
// the chat. The bot's text is its own Telegram HTML, cut down to Telegram's tag set with no
// attributes but an `<a>`'s href, so no scenario input can put markup on the page.
import type { Button, Transcript } from '../../../scripts/docs-chats/recorder';
import ChartEmbed from './ChartEmbed.astro';
import '../styles/chat.css';

interface Props {
  readonly name: string;
}

const { name } = Astro.props;
const transcripts = import.meta.glob<Transcript>('../generated/chats/*.json', {
  eager: true,
  import: 'default',
});
const transcript = transcripts[`../generated/chats/${name}.json`];
if (transcript === undefined) {
  throw new Error(`<Chat name="${name}">: no transcript; run pnpm docs:chats`);
}

const ALLOWED_TAGS = new Set(['b', 'i', 'u', 's', 'code', 'pre', 'a', 'blockquote', 'tg-spoiler']);
const SAFE_HREF = /^(?:https?:|tg:)/;

function allowTags(html: string): string {
  return html.replace(
    /<(\/?)([a-z][a-z-]*)([^<>]*)>|[<>]/gi,
    (match: string, close?: string, tag?: string, attrs?: string) => {
      if (tag === undefined) return match === '<' ? '&lt;' : '&gt;';
      const tagName = tag.toLowerCase();
      if (!ALLOWED_TAGS.has(tagName)) return '';
      if (close === '/') return `</${tagName}>`;
      if (tagName !== 'a') return `<${tagName}>`;
      const href = /\bhref="([^"]*)"/.exec(attrs ?? '')?.[1];
      return href !== undefined && SAFE_HREF.test(href) ? `<a href="${href}">` : '<a>';
    },
  );
}

// Every chart button of the chat, each with the id of the embed it opens.
interface Chart {
  readonly id: string;
  readonly button: Button & { readonly fragment: string };
}
const charts: Chart[] = [];
function chartId(button: Button): string | undefined {
  if (button.kind !== 'web_app' || button.fragment === undefined) return undefined;
  const id = `chart-${name}-${charts.length}`;
  charts.push({ id, button: { ...button, fragment: button.fragment } });
  return id;
}
---

<div class="tg-chat not-content" data-chat={name}>
  <div class="tg-transcript">
    {
      transcript.bubbles.map((bubble) => {
        switch (bubble.from) {
          case 'user':
            return (
              <div class="tg-row tg-row-user">
                {/* One line: the bubble keeps its whitespace (pre-wrap). */}
                <div class="tg-bubble tg-user">{bubble.author !== undefined && <div class="tg-author">{bubble.author}</div>}{bubble.text}</div>
              </div>
            );
          case 'bot':
            return (
              <div class="tg-row tg-row-bot">
                <div class="tg-message">
                  <div class="tg-bubble tg-bot" set:html={allowTags(bubble.html)} />
                  {bubble.buttons !== undefined && (
                    <div class="tg-keyboard">
                      {bubble.buttons.map((row) => (
                        <div class="tg-keyboard-row">
                          {row.map((button) => {
                            const embed = chartId(button);
                            return embed === undefined ? (
                              <span class:list={['tg-button', `tg-button-${button.kind}`]}>
                                {button.text}
                              </span>
                            ) : (
                              <button
                                type="button"
                                class="tg-button tg-button-web_app"
                                aria-controls={embed}
                                aria-expanded="false"
                              >
                                {button.text}
                              </button>
                            );
                          })}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          case 'bot-file':
            return (
              <div class="tg-row tg-row-bot">
                <div class="tg-bubble tg-bot tg-file">{bubble.fileName}</div>
              </div>
            );
          case 'toast':
            return <div class="tg-toast">{bubble.text}</div>;
        }
      })
    }
  </div>
  {
    transcript.replyKeyboard !== undefined && (
      <div class="tg-reply-keyboard">
        {transcript.replyKeyboard.map((row) => (
          <div class="tg-keyboard-row">
            {row.map((label) => (
              <span class="tg-reply-button">{label}</span>
            ))}
          </div>
        ))}
      </div>
    )
  }
</div>
{charts.map((chart) => <ChartEmbed id={chart.id} fragment={chart.button.fragment} title={chart.button.text} />)}

<script>
  // A chart button shows its embed, loading the iframe on the first click, and hides it again.
  for (const button of document.querySelectorAll<HTMLButtonElement>('.tg-button-web_app')) {
    button.addEventListener('click', () => {
      const embed = document.getElementById(button.getAttribute('aria-controls') ?? '');
      const frame = embed?.querySelector('iframe');
      if (embed == null || frame == null) return;
      if (frame.getAttribute('src') === null) frame.src = frame.dataset['src'] ?? '';
      embed.hidden = !embed.hidden;
      button.setAttribute('aria-expanded', String(!embed.hidden));
    });
  }
</script>
